# PMB OS runtime pack builder - every upstream input is pinned here (sourced by bash).
# Checksums are SHA-256 of the exact upstream artifact. A mismatch aborts the build.
# When bumping a version: update URL/version AND checksum, then re-run build-all.sh.
# Values may be overridden from the environment (e.g. WINE_VERSIONS="11.0" ./build-all.sh).

# ---- Pack set / repo metadata ---------------------------------------------------------
: "${PACKSET_VERSION:=1.0.0}"                # bumps the imagefs / pmbshm pack version
: "${SOURCE_DATE_EPOCH:=1767225600}"         # 2026-01-01T00:00:00Z: fixed mtimes in tarballs

# ---- Debian userland (imagefs, arm64 build containers) --------------------------------
: "${DEBIAN_SUITE:=bookworm}"
: "${DEBIAN_MIRROR:=http://deb.debian.org/debian}"
: "${DEBIAN_SECURITY_MIRROR:=http://deb.debian.org/debian-security}"
# Base image (multi-arch tag). For bit-for-bit reproducible build environments pin the
# manifest-list digest instead, e.g. debian@sha256:c67e92c8099ba22853ab4cfda7cfb494d253d6012ca82dee98ba8976772af018
: "${DEBIAN_IMAGE:=debian:bookworm-20261104-slim}"

# imagefs content (Debian binary packages; dependencies are resolved by apt). Exactly the
# native arm64 libraries box64 forwards wrapped calls to, plus Mesa's runtime deps.
# The post stage verifies that every DT_NEEDED of every arm64 ELF resolves inside imagefs.
: "${ROOTFS_PACKAGES:=libc6 libstdc++6 libgcc-s1 zlib1g libzstd1 libexpat1 \
libfreetype6 libfontconfig1 fontconfig-config fonts-dejavu-core fonts-liberation2 \
libx11-6 libx11-data libx11-xcb1 libxext6 libxrender1 libxrandr2 libxi6 libxfixes3 \
libxcursor1 libxcomposite1 libxinerama1 libxxf86vm1 libxshmfence1 libxau6 libxdmcp6 \
libxcb1 libxcb-dri2-0 libxcb-dri3-0 libxcb-glx0 libxcb-present0 libxcb-randr0 libxcb-shm0 \
libxcb-sync1 libxcb-xfixes0 libvulkan1 libdrm2 libgnutls30 ca-certificates dash netbase tzdata}"
# dash   -> <imagefs>/bin/sh (system()/popen()/wordexp() of the PMBOS_ROOTFS glibc)
# netbase -> /etc/services, /etc/protocols, /etc/rpc (getaddrinfo service names)
# tzdata -> /usr/share/zoneinfo (TZ=<IANA id>), /etc/localtime -> Etc/UTC by default
# Optional audio client libraries (no device access on Android; useful with a pulse server).
: "${ROOTFS_OPTIONAL_PACKAGES:=libasound2 libpulse0}"

# ---- glibc (Debian source rebuilt with patches/glibc-<upstream>-pmbos-{rootfs,execve}.patch) ----
# Pinned to EXACTLY the Debian version of the loader the APK ships (pmbos/tools/loader/VERSION,
# debian_version): on devices Debian's stock ld.so (<nativeLibraryDir>/libpmbld.so) runs the
# libc.so.6 rebuilt here, and ld.so/libc share private ABI (GLIBC_PRIVATE, rtld_global layout).
# build-all.sh refuses to run when these values differ from loader/VERSION. Bump both together
# (fetch-loader.sh, then the hashes below). The source files are fetched by stage fetch with these
# hashes: deb.debian.org pool, then snapshot.debian.org/file/<sha1> after the pool drops them.
: "${GLIBC_DEBIAN_VERSION:=2.36-9+deb12u14}"
: "${GLIBC_DSC_SHA256:=cfe1f0b8dc1fa211ce5a45b3725cc38b29f88667f1140ebdca6de35cf9c6f1fd}"
: "${GLIBC_DSC_SHA1:=702906fdb0f1b37205a2000b6715025fed8018cb}"
: "${GLIBC_ORIG_SHA256:=a543c02070d46ccaf866957efd13f10c924daa74c86a90a0254db09a92a708ee}"
: "${GLIBC_ORIG_SHA1:=d034128a6116dcf9e76c92f898ec63f4f4e65786}"
: "${GLIBC_DEBIAN_TAR_SHA256:=cf4ac9cd98185452cae3ef34e2e4ee12753e3d93fd0c62c61396d4a47eec902f}"
: "${GLIBC_DEBIAN_TAR_SHA1:=42404623ac3ac7cb1bcce7dc7441ef3782c13871}"
# Debian's stock libc6 .deb of the same version (= loader/VERSION deb_sha256/deb_sha1); its
# ld-linux-aarch64.so.1 is byte-for-byte the APK's libpmbld.so before seccomp-patch.py (= loader/VERSION
# loader_stock_sha256).
# Stage glibc runs the execve-redirect self-test with it (stock ld.so + rebuilt libc = devices).
: "${LIBC6_DEB_SHA256:=01f4330719fd4f65580e16ea5a0527f372fca750e8f588d26deaf09f2d3b1cf4}"
: "${LIBC6_DEB_SHA1:=85af57bf1f9fa075163e51c99d9536154c21ab7e}"
: "${LOADER_SHA256:=17538b8f9889a470c061f69a8fea8124da89627311cd16546c133a89f09056df}"

# ---- libxcb (must equal the upstream version of Debian's libxcb1 in DEBIAN_SUITE) -----
: "${LIBXCB_VERSION:=1.15}"
: "${LIBXCB_URL:=https://xorg.freedesktop.org/archive/individual/lib/libxcb-${LIBXCB_VERSION}.tar.xz}"
: "${LIBXCB_SHA256:=cc38744f817cf6814c847e2df37fcb8997357d72fa4bcbc228ae0fe47219a059}"
# libxcb 1.17.0 (trixie): 599ebf9996710fea71622e6e184f3a8ad5b43d0e5fa8c4e407123c88a59a6d55

# ---- box64 (git tag + commit; built from a git checkout) ------------------------------
: "${BOX64_VERSION:=0.4.4}"
: "${BOX64_GIT:=https://github.com/ptitSeb/box64.git}"
: "${BOX64_COMMIT:=2f130fab1d6e1a4ee8a71dc60cfdfcc839ad192a}"   # tag v0.4.4
# Variants: "generic" -> pack "box64" (usr/bin/box64); any other name X is a box64 CMake
# SoC option (upper-cased, e.g. sd8g2 -> -DSD8G2=ON) -> pack "box64-X" (usr/bin/box64-X).
: "${BOX64_VARIANTS:=generic sd8g2 sd888}"

# ---- Wine (new WoW64: --enable-archs=x86_64,i386) -------------------------------------
# Space separated list; the first one is flagged "recommended" in the index.
: "${WINE_VERSIONS:=11.0}"  # 11.22 dropped: i386 mingw ICE in oleaut32/vartype.c (gcc bug)
# Subset of WINE_VERSIONS built by this run of stage wine (empty = all). Lets CI build each version in
# its own job; "recommended" still goes to the first entry of WINE_VERSIONS.
: "${WINE_BUILD_VERSIONS:=}"
WINE_URL_11_0="https://dl.winehq.org/wine/source/11.0/wine-11.0.tar.xz"
WINE_SHA256_11_0="c07a6857933c1fc60dff5448d79f39c92481c1e9db5aa628db9d0358446e0701"
WINE_MONO_11_0="10.4.1"
WINE_URL_11_22="https://dl.winehq.org/wine/source/11.x/wine-11.22.tar.xz"
WINE_SHA256_11_22="f172e9c1be73e862057deae1f0e03ce95919986c5df8a18e1c0829c34863c9ee"
WINE_MONO_11_22="11.3.0"

# ---- Wine addons (shared by all wine builds through share/wine/{mono,gecko} links) -----
WINE_MONO_URL_10_4_1="https://dl.winehq.org/wine/wine-mono/10.4.1/wine-mono-10.4.1-x86.tar.xz"
WINE_MONO_SHA256_10_4_1="a16606ef0724202e6a6848ece6e0cbba64d11e2f11aefe744af1d93c6d9f99bb"
WINE_MONO_URL_11_3_0="https://dl.winehq.org/wine/wine-mono/11.3.0/wine-mono-11.3.0-x86.tar.xz"
WINE_MONO_SHA256_11_3_0="54a1b0111c3fe4b785eae688af94d27e64995707ad648b6fee8000381b80d298"
: "${WINE_GECKO_VERSION:=2.47.4}"
: "${WINE_GECKO_X86_URL:=https://dl.winehq.org/wine/wine-gecko/2.47.4/wine-gecko-2.47.4-x86.tar.xz}"
: "${WINE_GECKO_X86_SHA256:=2cfc8d5c948602e21eff8a78613e1826f2d033df9672cace87fed56e8310afb6}"
: "${WINE_GECKO_X64_URL:=https://dl.winehq.org/wine/wine-gecko/2.47.4/wine-gecko-2.47.4-x86_64.tar.xz}"
: "${WINE_GECKO_X64_SHA256:=fd88fc7e537d058d7a8abf0c1ebc90c574892a466de86706a26d254710a82814}"

# ---- Mesa (Turnip Vulkan on KGSL + Zink OpenGL/EGL) ------------------------------------
: "${MESA_VERSION:=26.3.1}"
: "${MESA_URL:=https://archive.mesa3d.org/mesa-${MESA_VERSION}.tar.xz}"
: "${MESA_SHA256:=4e4e438eac7b840a9383988cbb7c08dad8041da544b9319fc26d319fa7348961}"
# Python build deps of Mesa installed with pip inside the arm64 container (Debian
# bookworm ships meson 1.0, Mesa >= 26 needs >= 1.5).
: "${MESA_PIP_PACKAGES:=meson==1.10.2 mako==1.3.10 PyYAML==6.0.3 packaging==25.0}"

# ---- DXVK / VKD3D-Proton (official release tarballs, repacked) -------------------------
: "${DXVK_VERSION:=3.1.1}"
: "${DXVK_URL:=https://github.com/doitsujin/dxvk/releases/download/v${DXVK_VERSION}/dxvk-${DXVK_VERSION}.tar.gz}"
: "${DXVK_SHA256:=40565b4a724aadc4433fa4e010b4b23916d9b1f1baeee64e17186db94f54e608}"
: "${VKD3D_VERSION:=3.1}"
: "${VKD3D_URL:=https://github.com/HansKristian-Work/vkd3d-proton/releases/download/v${VKD3D_VERSION}/vkd3d-proton-${VKD3D_VERSION}.tar.zst}"
: "${VKD3D_SHA256:=b85ea8219b71093a3924913dd7aae6172333dc0c069983ed510816d67f02120b}"

# ---- Packing ---------------------------------------------------------------------------
# Plain LZMA2, no BCJ/ARM64 filter (decodable by any xz implementation), CRC32 check.
# -9e needs a 64 MiB dictionary in the decoder; lower it with XZ_OPTS="-6e" if the
# on-device decoder must run in a small heap.
: "${XZ_OPTS:=-9e --threads=0 --check=crc32}"
# PT_INTERP placeholder length (characters, without the terminating NUL). Only the DIRECT exec
# mode (targetSdk <= 28) needs the runtime to rewrite it; the LOADER mode ignores it.
: "${INTERP_PLACEHOLDER_LEN:=255}"
