+#if defined(SIOCGIFCONF) && defined(SIOCGIFINDEX)
+/* PMB OS: if_nameindex() lists the interfaces over netlink (RTM_GETLINK), which Android denies to apps (EACCES), so
+ * it returns NULL there. Enumerate the interfaces that have an IPv4 address with SIOCGIFCONF instead and take their
+ * indices with SIOCGIFINDEX on the same AF_INET socket (glibc's if_nametoindex() uses an AF_UNIX socket, whose
+ * ioctls Android denies as well), and always offer the loopback interface. */
+static unsigned int if_index_ioctl( int fd, const char *name )
+{
+    struct ifreq req;
+
+    memset( &req, 0, sizeof(req) );
+    memcpy( req.ifr_name, name, min( strlen( name ) + 1, IFNAMSIZ - 1 ) );
+    if (ioctl( fd, SIOCGIFINDEX, &req )) return 0;
+    return req.ifr_ifindex > 0 ? req.ifr_ifindex : 0;
+}
+
+static unsigned int update_if_table_ioctl( void )
+{
+    struct ifreq reqs[64];
+    struct ifconf ifc;
+    unsigned int append_count = 0, index;
+    char name[IFNAMSIZ];
+    int fd, i, count, have_lo = 0;
+
+    if ((fd = socket( AF_INET, SOCK_DGRAM, 0 )) == -1) return 0;
+    ifc.ifc_len = sizeof(reqs);
+    ifc.ifc_req = reqs;
+    count = ioctl( fd, SIOCGIFCONF, &ifc ) ? 0 : ifc.ifc_len / sizeof(struct ifreq);
+
+    for (i = 0; i < count; i++)
+    {
+        memcpy( name, reqs[i].ifr_name, IFNAMSIZ );
+        name[IFNAMSIZ - 1] = 0;
+        if (!strcmp( name, "lo" )) have_lo = 1;
+        if (!(index = if_index_ioctl( fd, name ))) continue;
+        if (!find_entry_from_index( index ) && add_entry( index, name )) ++append_count;
+    }
+    if (!have_lo && (index = if_index_ioctl( fd, "lo" )))
+    {
+        strcpy( name, "lo" );
+        if (!find_entry_from_index( index ) && add_entry( index, name )) ++append_count;
+    }
+    close( fd );
+    return append_count;
+}
+#endif
