PMB OS patch: box64 resolves SysV shm through the global symbol scope
Upstream: box64 v0.4.4 (commit 2f130fab1d6e1a4ee8a71dc60cfdfcc839ad192a)
Apply:    git apply box64-0.4.4-pmbos-shm-plt.patch   (or patch -p1 --fuzz=0)

Why: box64 binds wrapped libc functions with dlsym(<libc.so.6 handle>, name). That lookup is
confined to libc's own dependency scope, so an LD_PRELOAD shim is never seen by x86_64 code.
On Android the kernel has no SysV IPC; PMB OS emulates shmget/shmat/shmdt/shmctl in
libpmbshm.so (LD_PRELOAD). wine's winex11.drv (x86_64, emulated) calls shmget/shmat for
MIT-SHM, so without this patch it would hit the real syscalls (ENOSYS / seccomp SIGSYS).
The four symbols become GOM wrappers (same signatures, no new wrapper types) whose bodies call
shmget() & co. through box64's PLT, i.e. the normal symbol scope where LD_PRELOAD wins.
Without a preload library they resolve to glibc exactly as before.
src/wrapped/generated/* is regenerated by box64's CMake (rebuild_wrappers.py) because
wrappedlibc_private.h changes; python3 must be available at build time.

--- a/src/wrapped/wrappedlibc.c
+++ b/src/wrapped/wrappedlibc.c
@@ -50,6 +50,7 @@
 #include <sys/types.h>
 #include <sys/ipc.h>
 #include <sys/sem.h>
+#include <sys/shm.h>
 #include <setjmp.h>
 #include <sys/vfs.h>
 #include <spawn.h>
@@ -4101,6 +4102,32 @@
     return ret;
 }
 
+/*
+ * PMB OS: SysV shared memory is resolved through the normal PLT (global symbol scope)
+ * instead of dlsym(<libc handle>), so that an LD_PRELOAD emulation library (libpmbshm.so,
+ * needed on Android where the kernel has no SysV IPC) is honoured for x86_64 callers too.
+ * Without a preload these resolve to glibc exactly as before.
+ */
+EXPORT void* my_shmat(int shmid, void* shmaddr, int shmflg)
+{
+    return shmat(shmid, shmaddr, shmflg);
+}
+
+EXPORT int my_shmctl(int shmid, int cmd, void* buf)
+{
+    return shmctl(shmid, cmd, (struct shmid_ds*)buf);
+}
+
+EXPORT int my_shmdt(void* shmaddr)
+{
+    return shmdt(shmaddr);
+}
+
+EXPORT int my_shmget(int key, size_t size, int shmflg)
+{
+    return shmget((key_t)key, size, shmflg);
+}
+
 EXPORT int64_t userdata_sign = 0x1234598765ABCEF0;
 EXPORT uint32_t userdata[1024];
 
--- a/src/wrapped/wrappedlibc_private.h
+++ b/src/wrapped/wrappedlibc_private.h
@@ -1860,10 +1860,10 @@
 #endif
 GO(sgetspent, pFp)
 GOW(sgetspent_r, iFpppLp)
-GO(shmat, pFipi)
-GO(shmctl, iFiip)
-GO(shmdt, iFp)
-GO(shmget, iFiLi)
+GOM(shmat, pFipi)
+GOM(shmctl, iFiip)
+GOM(shmdt, iFp)
+GOM(shmget, iFiLi)
 GOW(shutdown, iFii)
 GOWM(__sigaction, iFEipp)
 GOWM(sigaction, iFEipp)
