+/* PMB OS: a software synthesizer for systems without an ALSA sequencer (Android has none, so no MIDI device
+ * existed and MIDI music - RPG Maker, older games - stayed silent or failed). When PMBOS_SOUNDFONT names a SoundFont
+ * 2 file, a MIDI out device "PMB OS Synth" is offered; it renders with TinySoundFont (MIT, tsf.h) to the ALSA PCM
+ * "default" while it is open. */
+#define TSF_IMPLEMENTATION
+#define TSF_STATIC
+#include <math.h>
+#include "tsf.h"
+
+#define SYNTH_RATE 44100
+#define SYNTH_CHUNK 441 /* 10 ms */
+
+static pthread_mutex_t synth_mutex = PTHREAD_MUTEX_INITIALIZER;
+static tsf *synth;
+static snd_pcm_t *synth_pcm;
+static pthread_t synth_thread;
+static volatile int synth_running;
+
+static const char *synth_soundfont(void)
+{
+    const char *p = getenv("PMBOS_SOUNDFONT");
+    return p && *p && !access(p, R_OK) ? p : NULL;
+}
+
+/* all channels to their GM defaults; channel 10 plays drums */
+static void synth_defaults(void)
+{
+    int ch;
+    tsf_reset(synth);
+    for (ch = 0; ch < 16; ch++)
+    {
+        tsf_channel_set_presetnumber(synth, ch, 0, ch == 9);
+        tsf_channel_set_volume(synth, ch, 100.0f / 127.0f);
+        tsf_channel_set_pitchrange(synth, ch, 2.0f);
+    }
+}
+
+static void *synth_render(void *arg)
+{
+    short buf[SYNTH_CHUNK * 2];
+    while (synth_running)
+    {
+        snd_pcm_sframes_t n;
+        pthread_mutex_lock(&synth_mutex);
+        tsf_render_short(synth, buf, SYNTH_CHUNK, 0);
+        pthread_mutex_unlock(&synth_mutex);
+        n = snd_pcm_writei(synth_pcm, buf, SYNTH_CHUNK);
+        if (n < 0) n = snd_pcm_recover(synth_pcm, n, 1);
+        if (n < 0)
+        {
+            WARN("synth output: %s\n", snd_strerror(n));
+            break;
+        }
+    }
+    return NULL;
+}
+
+static UINT synth_start(void)
+{
+    const char *sf = synth_soundfont();
+    int err;
+    if (!sf) return MIDIERR_NODEVICE;
+    pthread_mutex_lock(&synth_mutex);
+    if (!synth)
+    {
+        if (!(synth = tsf_load_filename(sf)))
+        {
+            pthread_mutex_unlock(&synth_mutex);
+            ERR("cannot load the SoundFont %s\n", sf);
+            return MIDIERR_NODEVICE;
+        }
+        tsf_set_output(synth, TSF_STEREO_INTERLEAVED, SYNTH_RATE, 0.0f);
+        tsf_set_max_voices(synth, 96);
+    }
+    synth_defaults();
+    pthread_mutex_unlock(&synth_mutex);
+    if ((err = snd_pcm_open(&synth_pcm, "default", SND_PCM_STREAM_PLAYBACK, 0)) < 0)
+    {
+        ERR("cannot open the PCM for the synth: %s\n", snd_strerror(err));
+        return MMSYSERR_ALLOCATED;
+    }
+    if ((err = snd_pcm_set_params(synth_pcm, SND_PCM_FORMAT_S16_LE, SND_PCM_ACCESS_RW_INTERLEAVED, 2,
+                                  SYNTH_RATE, 1, 60000)) < 0)
+    {
+        ERR("synth PCM parameters: %s\n", snd_strerror(err));
+        snd_pcm_close(synth_pcm);
+        synth_pcm = NULL;
+        return MMSYSERR_ALLOCATED;
+    }
+    synth_running = 1;
+    if (pthread_create(&synth_thread, NULL, synth_render, NULL))
+    {
+        synth_running = 0;
+        snd_pcm_close(synth_pcm);
+        synth_pcm = NULL;
+        return MMSYSERR_NOMEM;
+    }
+    return MMSYSERR_NOERROR;
+}
+
+static void synth_stop(void)
+{
+    if (!synth_running) return;
+    synth_running = 0;
+    pthread_join(synth_thread, NULL);
+    snd_pcm_drop(synth_pcm);
+    snd_pcm_close(synth_pcm);
+    synth_pcm = NULL;
+    pthread_mutex_lock(&synth_mutex);
+    tsf_note_off_all(synth);
+    pthread_mutex_unlock(&synth_mutex);
+}
+
+static void synth_event(BYTE evt, BYTE d1, BYTE d2)
+{
+    int ch = evt & 0x0f;
+    pthread_mutex_lock(&synth_mutex);
+    if (synth)
+    {
+        switch (evt & 0xf0)
+        {
+        case 0x80: tsf_channel_note_off(synth, ch, d1); break;
+        case 0x90:
+            if (d2) tsf_channel_note_on(synth, ch, d1, d2 / 127.0f);
+            else tsf_channel_note_off(synth, ch, d1);
+            break;
+        case 0xb0: tsf_channel_midi_control(synth, ch, d1, d2); break;
+        case 0xc0: tsf_channel_set_presetnumber(synth, ch, d1, ch == 9); break;
+        case 0xe0: tsf_channel_set_pitchwheel(synth, ch, (d2 << 7) | d1); break;
+        default: break; /* aftertouch, system messages */
+        }
+    }
+    pthread_mutex_unlock(&synth_mutex);
+}
+
+/* GM / GS / XG reset SysEx: back to defaults */
+static void synth_sysex(const BYTE *data, UINT len)
+{
+    static const BYTE gm_on[] = {0xf0, 0x7e, 0x7f, 0x09, 0x01, 0xf7};
+    BOOL reset = len >= sizeof(gm_on) && !memcmp(data, gm_on, sizeof(gm_on));
+    if (len >= 11 && data[0] == 0xf0 && data[1] == 0x41 && data[4] == 0x12 && data[5] == 0x40 && data[6] == 0x00 &&
+        data[7] == 0x7f) reset = TRUE; /* GS reset */
+    if (len >= 9 && data[0] == 0xf0 && data[1] == 0x43 && data[3] == 0x4c && data[6] == 0x7e) reset = TRUE; /* XG */
+    if (!reset) return;
+    pthread_mutex_lock(&synth_mutex);
+    if (synth) synth_defaults();
+    pthread_mutex_unlock(&synth_mutex);
+}
+
+static void synth_add_dest(void)
+{
+    static const WCHAR name[] = {'P','M','B',' ','O','S',' ','S','y','n','t','h',0};
+    struct midi_dest *dest;
+
+    dests = realloc(dests, (num_dests + 1) * sizeof(*dests));
+    dest = dests + num_dests;
+    memset(dest, 0, sizeof(*dest));
+    dest->synth = TRUE;
+    dest->caps.wMid = 0x00FF;
+    dest->caps.wPid = 0x0002;
+    dest->caps.vDriverVersion = 0x001;
+    dest->caps.wTechnology = MOD_SWSYNTH;
+    dest->caps.wVoices = 32;
+    dest->caps.wNotes = 96;
+    dest->caps.wChannelMask = 0xFFFF;
+    dest->caps.dwSupport = 0;
+    memcpy(dest->caps.szPname, name, sizeof(name));
+    dest->bEnabled = TRUE;
+    dest->port_out = -1;
+    num_dests++;
+}
