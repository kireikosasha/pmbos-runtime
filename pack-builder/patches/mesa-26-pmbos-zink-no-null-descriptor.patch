+/* placeholders for devices without robustness2.nullDescriptor: see zink_context::null_desc */
+static void
+destroy_null_descriptors(struct zink_context *ctx)
+{
+   struct zink_screen *screen = zink_screen(ctx->base.screen);
+   if (ctx->null_desc.sampler)
+      VKSCR(DestroySampler)(screen->dev, ctx->null_desc.sampler, NULL);
+   if (ctx->null_desc.imageview)
+      VKSCR(DestroyImageView)(screen->dev, ctx->null_desc.imageview, NULL);
+   if (ctx->null_desc.bufferview)
+      VKSCR(DestroyBufferView)(screen->dev, ctx->null_desc.bufferview, NULL);
+   pipe_resource_reference(&ctx->null_desc.texture, NULL);
+   pipe_resource_reference(&ctx->null_desc.buffer, NULL);
+   memset(&ctx->null_desc, 0, sizeof(ctx->null_desc));
+}
+
+static bool
+create_null_descriptors(struct zink_context *ctx)
+{
+   struct zink_screen *screen = zink_screen(ctx->base.screen);
+   /* big enough for any UBO range a shader declares and for a few vertices at small strides */
+   const unsigned buffer_size = 65536;
+
+   ctx->null_desc.buffer = pipe_buffer_create(&screen->base,
+      PIPE_BIND_VERTEX_BUFFER | PIPE_BIND_CONSTANT_BUFFER | PIPE_BIND_SHADER_BUFFER |
+      PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_SHADER_IMAGE, PIPE_USAGE_DEFAULT, buffer_size);
+   struct pipe_resource templ = {0};
+   templ.target = PIPE_TEXTURE_2D;
+   templ.format = PIPE_FORMAT_R8G8B8A8_UNORM;
+   templ.width0 = templ.height0 = 1;
+   templ.depth0 = templ.array_size = 1;
+   templ.bind = PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_SHADER_IMAGE;
+   templ.usage = PIPE_USAGE_DEFAULT;
+   ctx->null_desc.texture = screen->base.resource_create(&screen->base, &templ);
+   if (!ctx->null_desc.buffer || !ctx->null_desc.texture)
+      goto fail;
+   struct zink_resource *buf = zink_resource(ctx->null_desc.buffer);
+   struct zink_resource *tex = zink_resource(ctx->null_desc.texture);
+
+   VkBufferViewCreateInfo bvci = {0};
+   bvci.sType = VK_STRUCTURE_TYPE_BUFFER_VIEW_CREATE_INFO;
+   bvci.buffer = buf->obj->buffer;
+   bvci.format = VK_FORMAT_R8G8B8A8_UNORM;
+   bvci.offset = 0;
+   bvci.range = VK_WHOLE_SIZE;
+   if (VKSCR(CreateBufferView)(screen->dev, &bvci, NULL, &ctx->null_desc.bufferview) != VK_SUCCESS)
+      goto fail;
+
+   VkImageViewCreateInfo ivci = {0};
+   ivci.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+   ivci.image = tex->obj->image;
+   ivci.viewType = VK_IMAGE_VIEW_TYPE_2D;
+   ivci.format = VK_FORMAT_R8G8B8A8_UNORM;
+   ivci.components.r = ivci.components.g = ivci.components.b = ivci.components.a = VK_COMPONENT_SWIZZLE_IDENTITY;
+   ivci.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+   ivci.subresourceRange.levelCount = 1;
+   ivci.subresourceRange.layerCount = 1;
+   if (VKSCR(CreateImageView)(screen->dev, &ivci, NULL, &ctx->null_desc.imageview) != VK_SUCCESS)
+      goto fail;
+
+   VkSamplerCreateInfo sci = {0};
+   sci.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO;
+   sci.magFilter = sci.minFilter = VK_FILTER_NEAREST;
+   sci.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+   sci.addressModeU = sci.addressModeV = sci.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+   sci.borderColor = VK_BORDER_COLOR_FLOAT_TRANSPARENT_BLACK;
+   if (VKSCR(CreateSampler)(screen->dev, &sci, NULL, &ctx->null_desc.sampler) != VK_SUCCESS)
+      goto fail;
+
+   /* GL: loads from unbound images / buffers return 0 */
+   static const uint32_t zeros[1024] = {0};
+   for (unsigned off = 0; off < buffer_size; off += sizeof(zeros))
+      pipe_buffer_write(&ctx->base, ctx->null_desc.buffer, off, sizeof(zeros), zeros);
+   /* an upload, not clear_texture: that renders into the texture, which isn't a render target */
+   struct pipe_box box = {0};
+   box.width = box.height = box.depth = 1;
+   ctx->base.texture_subdata(&ctx->base, ctx->null_desc.texture, 0, PIPE_MAP_WRITE, &box, zeros, 4, 4);
+   /* GENERAL is valid for both sampled and storage use; the texture is never bound any other way */
+   screen->image_barrier(ctx, tex, VK_IMAGE_LAYOUT_GENERAL,
+                         VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT,
+                         VK_PIPELINE_STAGE_VERTEX_SHADER_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT |
+                         VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT);
+   screen->buffer_barrier(ctx, buf,
+                          VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_UNIFORM_READ_BIT |
+                          VK_ACCESS_VERTEX_ATTRIBUTE_READ_BIT,
+                          VK_PIPELINE_STAGE_VERTEX_INPUT_BIT | VK_PIPELINE_STAGE_VERTEX_SHADER_BIT |
+                          VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT);
+   return true;
+
+fail:
+   mesa_loge("ZINK: failed to create placeholder descriptors");
+   destroy_null_descriptors(ctx);
+   return false;
+}
