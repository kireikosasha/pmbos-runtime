+#ifdef __linux__
+/* PMB OS: FUSE file systems that look names up case-insensitively by themselves. Android's shared storage
+ * (/storage/emulated, served by the MediaProvider FUSE daemon) is one: every lookup already matches any case, and
+ * reading a directory through the daemon costs about 0.2 ms per entry. Stock Wine does not know, so every file that
+ * is not found there (each file being created, each DLL / module probe) made it read the whole directory: creating
+ * files in a directory of 1000 ran at 6 files per second. The answer is found once per file system by looking an
+ * existing entry up under a name with the other case, and remembered. */
+static pthread_mutex_t fuse_case_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct { dev_t dev; BOOLEAN sensitive; } fuse_case_cache[32];
+static unsigned int fuse_case_count;
+
+/* the remembered answer for a FUSE file system: 1 = case sensitive, 0 = insensitive, -1 = not known yet */
+static int fuse_case_lookup( dev_t dev )
+{
+    unsigned int i;
+    int known = -1;
+
+    mutex_lock( &fuse_case_mutex );
+    for (i = 0; i < fuse_case_count; i++)
+        if (fuse_case_cache[i].dev == dev) known = fuse_case_cache[i].sensitive;
+    mutex_unlock( &fuse_case_mutex );
+    return known;
+}
+
+static BOOLEAN get_fuse_case_sensitivity( int fd )
+{
+    struct stat st, st1, st2;
+    struct dirent *de;
+    unsigned int i;
+    int dfd, known;
+    DIR *dir;
+
+    if (fstat( fd, &st )) return TRUE;
+    if ((known = fuse_case_lookup( st.st_dev )) != -1) return known;
+    if (!fstatat( fd, ".ciopfs", &st1, AT_NO_AUTOMOUNT )) return FALSE;  /* CIOPFS marks its directories */
+
+    /* find an entry with a letter in its name and look it up with the case of the letters flipped */
+    if ((dfd = openat( fd, ".", O_RDONLY | O_DIRECTORY | O_NONBLOCK )) == -1) return TRUE;
+    if (!(dir = fdopendir( dfd )))
+    {
+        close( dfd );
+        return TRUE;
+    }
+    while (known == -1 && (de = readdir( dir )))
+    {
+        char flipped[sizeof(de->d_name)];
+        BOOL changed = FALSE;
+        size_t len = strlen( de->d_name );
+
+        if (len >= sizeof(flipped)) continue;
+        for (i = 0; i <= len; i++)
+        {
+            char c = de->d_name[i];
+            if (c >= 'a' && c <= 'z') { c -= 'a' - 'A'; changed = TRUE; }
+            else if (c >= 'A' && c <= 'Z') { c += 'a' - 'A'; changed = TRUE; }
+            flipped[i] = c;
+        }
+        if (!changed) continue;
+        if (fstatat( fd, de->d_name, &st1, AT_SYMLINK_NOFOLLOW )) continue;
+        if (fstatat( fd, flipped, &st2, AT_SYMLINK_NOFOLLOW )) known = TRUE;
+        else known = !(st1.st_dev == st2.st_dev && st1.st_ino == st2.st_ino);
+    }
+    closedir( dir );
+    if (known == -1) return TRUE;  /* nothing to test with: an empty directory is cheap to search anyway */
+
+    mutex_lock( &fuse_case_mutex );
+    if (fuse_case_count < ARRAY_SIZE(fuse_case_cache))
+    {
+        fuse_case_cache[fuse_case_count].dev = st.st_dev;
+        fuse_case_cache[fuse_case_count].sensitive = known;
+        fuse_case_count++;
+    }
+    mutex_unlock( &fuse_case_mutex );
+    TRACE( "FUSE file system %lx is case %s\n", (unsigned long)st.st_dev, known ? "sensitive" : "insensitive" );
+    return known;
+}
+#endif
+
