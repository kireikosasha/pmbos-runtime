+/* Replaces the execve entry of syscalls.list (the plain syscall stub).
+   With PMBOS_LOADER unset - or on a machine without the redirect - this is
+   exactly that stub.  See pmbos-execve.h for the redirect.  */
+
+#include <alloca.h>
+#include <elf.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stddef.h>
+/* Compiler-generated memset/memcpy calls (byte loops) bind to libc's hidden
+   internal symbols.  */
+#include <string.h>
+#include <unistd.h>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <not-cancel.h>
+#include <sysdep.h>
+
+#if defined __aarch64__ && !defined __AARCH64EB__
+# define PMBOS_ELF_MACHINE EM_AARCH64
+#elif defined __x86_64__ && defined __LP64__
+# define PMBOS_ELF_MACHINE EM_X86_64
+#endif
+
+#ifdef PMBOS_ELF_MACHINE
+
+/* Hooks of pmbos-execve.h.  Only syscall wrappers: this code also runs in
+   the vfork-like child of posix_spawn.  */
+
+static int
+pmbos_x_filetype (const char *path)
+{
+  struct __stat64_t64 st;
+  if (__fstatat64_time64 (AT_FDCWD, path, &st, 0) != 0)
+    return -errno;
+  return S_ISREG (st.st_mode) ? 1 : 0;
+}
+
+static int
+pmbos_x_open (const char *path)
+{
+  int fd = __open64_nocancel (path,
+			      O_RDONLY | O_CLOEXEC | O_NOCTTY | O_NONBLOCK);
+  return fd < 0 ? -errno : fd;
+}
+
+static long int
+pmbos_x_pread (int fd, void *buf, size_t len, unsigned long long off)
+{
+  ssize_t r = __pread64_nocancel (fd, buf, len, (__off64_t) off);
+  return r < 0 ? -errno : (long int) r;
+}
+
+static int
+pmbos_x_access_x (const char *path)
+{
+  return __access (path, X_OK) == 0 ? 0 : -errno;
+}
+
+static unsigned long long
+pmbos_x_stack_rlimit (void)
+{
+  struct rlimit rl;
+  if (__getrlimit (RLIMIT_STACK, &rl) != 0)
+    return RLIM_INFINITY;
+  return rl.rlim_cur;
+}
+
+static int
+pmbos_x_execve (const char *path, char *const argv[], char *const envp[])
+{
+  return INTERNAL_SYSCALL_CALL (execve, path, argv, envp);
+}
+
+# define PMBOS_X_FILETYPE(path) pmbos_x_filetype (path)
+# define PMBOS_X_OPEN(path) pmbos_x_open (path)
+# define PMBOS_X_PREAD(fd, buf, len, off) pmbos_x_pread (fd, buf, len, off)
+# define PMBOS_X_CLOSE(fd) __close_nocancel_nostatus (fd)
+# define PMBOS_X_ACCESS_X(path) pmbos_x_access_x (path)
+# define PMBOS_X_EXECVE(path, argv, envp) pmbos_x_execve (path, argv, envp)
+# define PMBOS_X_STACK_RLIMIT() pmbos_x_stack_rlimit ()
+# define PMBOS_X_ENVIRON __environ
+# define PMBOS_X_SECURE __libc_enable_secure
+# define PMBOS_X_ALLOCA(size) alloca (size)
+
+# include "pmbos-execve.h"
+
+int
+__execve (const char *path, char *const argv[], char *const envp[])
+{
+  /* Returns only on failure.  */
+  int ret = __pmbos_execve (path, argv, envp);
+  return INLINE_SYSCALL_ERROR_RETURN_VALUE (-ret);
+}
+
+#else /* !PMBOS_ELF_MACHINE */
+
+int
+__execve (const char *path, char *const argv[], char *const envp[])
+{
+  return INLINE_SYSCALL_CALL (execve, path, argv, envp);
+}
+
+#endif
+
+weak_alias (__execve, execve)
